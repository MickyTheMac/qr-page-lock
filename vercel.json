{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/pagelock?__path=:path*" },
    { "source": "/C/:code*", "destination": "/check/index.html" },
    { "source": "/P/:code*", "destination": "/check/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
