// Generates the test fixture PDFs in /fixtures for manual testing in the app.
import { mkdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { makeSampleAgreement } from "../tests/helpers";
import * as T from "../tests/tamper";
import { parseReference, preparePdf, serializeManifestFile, verifyPdf } from "../src/lib/pagelock";

(async () => {
  const dir = join(__dirname, "..", "fixtures");
  mkdirSync(dir, { recursive: true });
  const fixed = { documentId: "7K3MQ2XR9VDF4HNC8WBT6JZP", createdAt: "2026-11-26T09:00:00.000Z" };
  const original = await makeSampleAgreement(3);
  const g = await preparePdf(original, fixed);
  const other = await preparePdf(await makeSampleAgreement(3, { marker: "Draft B - different wording" }), {
    documentId: "2B8NW4QK6TXR3MVA9HJD5CFE",
    createdAt: fixed.createdAt,
  });
  const forged = await preparePdf(await T.changeOriginalCharacter(original), { createdAt: fixed.createdAt, documentId: "9QX4TB7M2KWR6HDN3CVF8JZA" });
  const files: [string, Uint8Array, string][] = [
    ["00-original-unsealed.pdf", original, "Plain agreement before sealing. Use on the Create page. On Verify: UNABLE TO VERIFY."],
    ["01-sealed-genuine.pdf", g.pdfBytes, "REFERENCE MATCH with the reference file; INTERNALLY CONSISTENT without it."],
    ["02-changed-character.pdf", await T.changeCharacter(g.pdfBytes), "Page 1 says 60% instead of 50%. ALTERED / INVALID."],
    ["03-copied-qr.pdf", await T.copyQr(g.pdfBytes, 0, 1), "Page 1's seal pasted onto page 2. ALTERED / INVALID."],
    ["04-page-replaced.pdf", await T.replacePage(g.pdfBytes, other.pdfBytes, 1), "Page 2 swapped for a page from another sealed document. ALTERED / INVALID."],
    ["05-page-inserted.pdf", await T.insertPage(g.pdfBytes, await makeSampleAgreement(1), 1), "Extra unsealed page added. ALTERED / INVALID."],
    ["06-page-deleted.pdf", await T.deletePage(g.pdfBytes, 1), "Page 2 removed. ALTERED / INVALID."],
    ["07-pages-reordered.pdf", await T.swapPages(g.pdfBytes, 1, 2), "Pages 2 and 3 swapped. ALTERED / INVALID."],
    ["08-cover-up-box.pdf", await T.overlayBox(g.pdfBytes), "White box drawn over a clause. ALTERED / INVALID."],
    ["09-footer-edited.pdf", await T.editFooterText(g.pdfBytes), "Footer text says 'of 9'. ALTERED / INVALID."],
    ["10-annotation-added.pdf", await T.addAnnotation(g.pdfBytes), "Text box added on top of page 1. ALTERED / INVALID."],
    ["11-edited-after-sealing.pdf", T.appendIncrementalUpdate(g.pdfBytes), "Saved again by an editor (extra revision). ALTERED / INVALID."],
    ["12-regenerated-chain.pdf", forged.pdfBytes, "Wording changed then re-sealed. INTERNALLY CONSISTENT alone, ALTERED / INVALID with the genuine reference."],
    ["13-different-document.pdf", other.pdfBytes, "A different sealed agreement. ALTERED / INVALID with the genuine reference."],
    ["14-qr-unreadable.pdf", await T.scrambleQr(g.pdfBytes, 1), "Page 2's QR code wiped. UNABLE TO VERIFY on its own; with the reference file the exact-file check also fails."],
    ["15-metadata-changed.pdf", await T.changeMetadata(g.pdfBytes), "Title changed only. ALTERED / INVALID with the reference file (exact file differs); REFERENCE MATCH with digest only."],
  ];
  const ref = await parseReference(serializeManifestFile(g.manifest));
  const lines = [
    "# Test fixtures",
    "",
    "Generated by `npm run fixtures`. The trusted reference for the genuine document is `01-sealed-genuine.pagelock-reference.json`",
    `(manifest digest \`${g.manifest.manifestDigest}\`).`,
    "",
    "| File | What was done | Result without reference | Result with genuine reference |",
    "| --- | --- | --- | --- |",
  ];
  for (const [name, bytes, note] of files) {
    writeFileSync(join(dir, name), bytes);
    const a = (await verifyPdf(bytes)).outcome;
    const b = (await verifyPdf(bytes, { reference: ref })).outcome;
    lines.push(`| ${name} | ${note} | ${a} | ${b} |`);
  }
  writeFileSync(join(dir, "01-sealed-genuine.pagelock-reference.json"), serializeManifestFile(g.manifest));
  writeFileSync(join(dir, "README.md"), lines.join("\n") + "\n");
  console.log(lines.join("\n"));
})();
